{
  "name": "Sagebrush",
  "type": "dark",
  "colors": {
    // Workbench core UI surfaces
    "editor.background": "#2d353b",
    "editor.foreground": "#d3c6aa",
    "sideBar.background": "#232a2e",
    "sideBar.foreground": "#9da9a0",
    "activityBar.background": "#232a2e",
    "activityBar.foreground": "#d3c6aa",
    "statusBar.background": "#232a2e",
    "statusBar.foreground": "#d3c6aa",
    "titleBar.activeBackground": "#2d353b",
    "titleBar.activeForeground": "#d3c6aa",
    
    // UI Highlights & Selections
    "editor.selectionBackground": "#475258",
    "editor.lineHighlightBackground": "#343f44",
    "list.activeSelectionBackground": "#3c4841",
    "list.activeSelectionForeground": "#a7c080"
  },
  "tokenColors": [
    {
      "name": "Keywords & Control",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#e67e80" } // Muted Soft Red
    },
    {
      "name": "Strings & Character data",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#a7c080" } // Sagebrush Green
    },
    {
      "name": "Functions & Methods",
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#83c092" } // Soft Teal/Aqua
    },
    {
      "name": "Variables & Parameters",
      "scope": ["variable", "meta.parameter"],
      "settings": { "foreground": "#d3c6aa" } // Warm Foregound White
    },
    {
      "name": "Numbers & Booleans",
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#dbbc7f" } // Soft Amber/Yellow
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#859289", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Headings",
      "scope": ["heading.markdown", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#e67e80", "fontStyle": "bold" } // Matches your Muted Soft Red
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold.markdown", "punctuation.definition.bold.markdown"],
      "settings": { "foreground": "#83c092", "fontStyle": "bold" } // Matches your Soft Teal/Aqua
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic.markdown", "punctuation.definition.italic.markdown"],
      "settings": { "foreground": "#dbbc7f", "fontStyle": "italic" } // Matches your Soft Amber/Yellow
    }
  ]
}
